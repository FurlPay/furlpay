{
  "name": "@furlpay/mobile",
  "version": "2.0.0",
  "private": true,
  "description": "FurlPay native Android app (Expo + React Native). Standalone install — intentionally NOT an npm workspace so React 19 / react-native never hoist into the Next.js web app's tree.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:android": "eas build --platform android --profile production",
    "ios": "expo run:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  },
  "dependencies": {
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.101.2",
    "@types/react": "~19.0.10",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.10",
    "typescript": "~5.8.3"
  }
}
