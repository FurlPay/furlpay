# ---------------------------------------------------------------------------
# Stablecoin Super-App — environment variables
# All integrations run in MOCK mode by default so the app is fully runnable
# with zero credentials. Fill these in to swap a service to its live client.
# ---------------------------------------------------------------------------

# Master switch. "mock" (default) uses in-memory simulators. "live" requires keys.
INTEGRATION_MODE=mock

# Fingerprint / WebAuthn (FIDO2) — the Relying Party the passkey is bound to.
# RP_ID must be the site's registrable domain (no scheme/port); ORIGIN is the
# full origin the browser sees. Both accept a comma-separated list to support
# multiple domains (verification matches any; the FIRST value is the primary
# rpID used when generating options — set it to your registrable eTLD+1).
#   Prod example:  FURLPAY_RP_ID=furlpay.app   FURLPAY_ORIGIN=https://furlpay.app
# If unset, config is derived from Vercel's VERCEL_PROJECT_PRODUCTION_URL /
# VERCEL_URL, falling back to the localhost defaults below. The rpID is NEVER
# read from the request Host header (that would break phishing resistance).
FURLPAY_RP_ID=localhost
FURLPAY_ORIGIN=http://localhost:3000

# Client-IP trust for rate limits. Leave UNSET on Vercel (it sets x-real-ip).
# Behind CloudFront -> ALB (infra/aws) set 2: the viewer is the 2nd
# X-Forwarded-For entry from the right; anything left of it is client-typed.
FURLPAY_TRUSTED_PROXY_HOPS=

# Public origin clients use (https://host, no path). Leave UNSET on Vercel.
# Behind CloudFront -> ALB the request URL is the container bind address, so
# redirects, the OAuth issuer and DPoP htu need this. Boot refuses without it
# when ORIGIN_VERIFY_REQUIRED=true.
PUBLIC_API_ORIGIN=

# Client analytics ingestion kill switch (POST /api/analytics/events). Set to
# "off" to refuse ingestion with 503; clients queue or drop, the app is unaffected.
FURLPAY_ANALYTICS_INGEST=

# Android app's WebAuthn origin. REQUIRED for passkey sign-in from the native
# app: a native caller does not present https://furlpay.com — Play Services
# presents android:apk-key-hash:<base64url(SHA-256(signing cert))>. Give the
# signing certificate's SHA-256 (hex, colons optional) and the server derives
# that origin. Without it, every passkey assertion from the app is rejected on
# origin, no matter how correct the ceremony.
#
# The upload key's SHA-256 (apps/android/android.keystore):
#   15:92:F6:8B:BE:16:5A:EF:47:EB:51:30:39:A2:64:EF:41:95:6E:52:77:CB:8A:29:9B:9E:AD:E6:C1:13:29:13
# AFTER the first Play upload, Play re-signs the app — append the Play App
# Signing SHA-256 here too (comma-separated), exactly as you must in
# /.well-known/assetlinks.json. Get it from Play Console → App integrity.
FURLPAY_ANDROID_CERT_SHA256=

# Browser-extension WebAuthn origin. Since Chrome 122 an extension may assert a
# passkey for any rpID in its host_permissions; the browser reports the caller
# as chrome-extension://<id>, which this RP must trust explicitly (same
# mechanic as the Android apk-key-hash above). Set this ONLY to extension ids
# you publish — every value here is an origin allowed to approve payments, so a
# malicious extension update becomes a signing surface. Exact 32-char ids only
# (a-p); wildcards and malformed values are rejected. Comma-separated for a
# stable + beta channel. Leave EMPTY to reject all extension assertions.
FURLPAY_EXTENSION_ID=

# Session signing key (jose HS256). REQUIRED in production — the app refuses to
# start signing sessions with the weak dev fallback. Use >= 32 random chars.
FURLPAY_SESSION_SECRET=

# The ONLY account email allowed to hold the admin role (ops dashboard,
# compliance console, refunds). Defaults to the seeded founder account.
FURLPAY_ADMIN_EMAIL=ashutosh@furlpay.app

# Self-custodial wallet rollout stage (docs/SELF-CUSTODIAL-WALLET-DESIGN.md).
# Self-custody rollout ladder (docs/SELF-CUSTODIAL-WALLET-DESIGN.md). Each
# stage is additive and must not be skipped -- every stage assumes the one
# below it is live.
#   0  off. No behavior change; balances are the ledger cache.
#   1  wallet linking. /api/wallet/link/{challenge,verify} accept a device
#      signature and record User.linkedWallet. NO displayed money changes.
#   2  on-chain balance reads. lib/services/usdcBalances.ts reads live USDC on
#      Base/Arbitrum/Solana for the linked address, tagged asOf.source="chain",
#      degrading per chain to the tagged cache when an RPC is unreachable.
#   3  per-user deposit addresses (NOT IMPLEMENTED -- deposit-detect still
#      credits the shared demo singleton).
#   4  real gasless send from the linked address (needs a funded relayer; see
#      FURLPAY_RELAYER_* below).
FURLPAY_SELF_CUSTODY_STAGE=0

# Solana Actions / Blinks + Visa USDC settlement. MERCHANT_SOLANA_WALLET is the
# base58 treasury that receives settlements (Visa settles USDC on Solana to bank
# agents such as Cross River Bank / Lead Bank). Left blank, the Action endpoints
# build spec-correct demo transactions with no live RPC required.
MERCHANT_SOLANA_WALLET=
SOLANA_RPC_URL=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Platform take rate on Solana checkouts, in basis points (50 = 0.5%, max
# 1000), split to PLATFORM_FEE_SOLANA_WALLET as a second transfer in the same
# transaction. Both must be set AND differ from MERCHANT_SOLANA_WALLET to
# activate — first-party checkouts (merchant == platform) need no split.
PLATFORM_FEE_BPS=
PLATFORM_FEE_SOLANA_WALLET=
# SOL/USD price used to size the SOL payment path (mock; use an oracle in prod).
SOLANA_SOL_USD_PRICE=150

# Compressed-NFT ticket receipts (Metaplex Bubblegum via Helius mint API).
# Unset = deterministic mock tickets with the identical response shape.
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Live flight/hotel search + booking (Duffel). duffel_test_ tokens return
# sandbox offers with the production schema; unset falls back to the demo
# inventory generator.
DUFFEL_API_KEY=

# Tripadvisor Terra -- travel discovery content (locations, ratings, official
# URLs). Auth is the X-API-Key HEADER; ?key= and Bearer both 401.
# CONTENT ONLY: no prices, no availability, no booking -- Duffel remains the
# only booking rail. Reviews and photos are NOT in this entitlement (404).
# Absent => discovery degrades gracefully; travel booking is unaffected.
TRIPADVISOR_API_KEY=

# Sign in with Google (Google Identity Services). Create an OAuth 2.0 Web client
# in Google Cloud Console; add your origin to "Authorized JavaScript origins".
# NEXT_PUBLIC_* is exposed to the browser to render the button; GOOGLE_CLIENT_ID
# is used server-side to verify the ID token. Leave blank to use the dev stub.
#
# GOOGLE_CLIENT_ID accepts a COMMA-SEPARATED list of accepted audiences. The
# native Android app is a SEPARATE OAuth client (create an "Android" client with
# package name com.furlpay.app and the signing cert's SHA-1:
#   77:65:71:D1:D1:89:26:9D:84:0D:02:2A:F0:78:85:F2:55:B5:A3:99
# ) and Google stamps its id_token with THAT client id as `aud`. List both here
# or every sign-in from the app is rejected as wrong-audience:
#   GOOGLE_CLIENT_ID=<web>.apps.googleusercontent.com,<android>.apps.googleusercontent.com
# The first entry stays the canonical one for the web button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Phone / email OTP (Twilio Verify). Create a Verify Service and paste its SID.
# Left blank (INTEGRATION_MODE=mock) codes are generated in-memory and logged to
# the server console so signup/login work with zero credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Auth & remote key management (Turnkey / Dynamic.xyz).
#
# NOTE ON WHAT TURNKEY IS. It signs inside an enclave, so no private key ever
# enters this process — that is the property FURLPAY_KMS_PROVIDER=turnkey
# asserts. It is NOT a threshold scheme: Turnkey returns a COMPLETE signature,
# so whoever holds the organisation credential can move the funds behind any
# wallet in the organisation. Wallets signed for here are CUSTODIAL.
DYNAMIC_ENVIRONMENT_ID=
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Which Turnkey wallet serves each logical key (lib/kms.ts KEY_PURPOSES).
# Addresses are public: configuration, not secrets. A key with no address is
# refused rather than falling through to another wallet.
TURNKEY_GAS_SPONSOR_ADDRESS=
TURNKEY_SETTLEMENT_ADDRESS=
TURNKEY_ATTESTATION_ADDRESS=

# On-chain smart accounts (Safe)
SAFE_TX_SERVICE_URL=
SAFE_RPC_URL=

# Fiat on/off-ramp (Bridge.xyz)
BRIDGE_API_KEY=

# FX & multi-currency banking (Wise)
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Cross-chain swap routing (Li.Fi). Live quotes work keyless at low rate
# limits; set the key for production traffic. LIFI_API_URL only needs changing
# for a self-hosted proxy (defaults to https://li.quest/v1).
LIFI_API_KEY=
LIFI_API_URL=
# Swap monetization (docs.li.fi/monetization-take-fees). LIFI_FEE is a FRACTION
# of from-token volume (0.002 = 0.2%, max 0.10) collected for LIFI_INTEGRATOR
# (defaults to "furlpay"; must match the API key's integrator string). Register
# fee-enabled at portal.li.fi BEFORE setting LIFI_FEE or quotes may fail.
LIFI_INTEGRATOR=
LIFI_FEE=

# Hard server-side per-transaction caps on the REAL execution rails (USD).
# Conservative launch defaults ($500 each) apply when unset; raise per rail as
# volume and monitoring mature. UI limits are advisory — these enforce.
FURLPAY_MAX_SWAP_USD=
FURLPAY_MAX_CCTP_USD=
FURLPAY_MAX_TRANSFER_USD=

# Fractional equities (Alpaca)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Card issuance (Marqeta / Lithic)
MARQETA_APP_TOKEN=
MARQETA_ADMIN_TOKEN=

# Compliance & risk scoring (Chainalysis / Persona)
CHAINALYSIS_API_KEY=

# KYC/AML alternative provider (Sumsub). SUMSUB_WEBHOOK_SECRET verifies the
# x-payload-digest header on POST /api/webhooks/sumsub (constant-time,
# HMAC_SHA1/256/512 per x-payload-digest-alg). App token pair drives the
# WebSDK access-token endpoint when Sumsub is the active KYC provider.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# Card issuing, stablecoin-native (Rain / Signify Holdings). JIT
# authorizations arrive on the existing /api/webhooks/card-auth processor;
# these credentials drive card provisioning API calls.
#
# Verified against Rain's public SDK, because the API reference at
# docs.rain.xyz is behind a partner login:
#   base URL  https://api.raincards.xyz/v1/issuing   (dev: api-dev.raincards.xyz)
#   auth      `Api-Key: <key>` header — NOT `Authorization: Bearer`
# Note the host is raincards.xyz; api.rain.xyz does not serve this API.
#
# Setting these does NOT enable card issuing. CARD_ISSUING_LIVE carries an
# `unimplemented` reason that flagState() checks BEFORE `enabled`, so the gate
# stays shut until there is a real issuer. See lib/cards/rainAdapter.ts.
RAIN_API_KEY=
RAIN_WEBHOOK_SECRET=
# Overrides the base URL. Defaults to api-dev.raincards.xyz outside production.
RAIN_API_URL=

# KYC/AML provider selection: identity = 'persona' | 'sumsub', screening = 'complyadvantage' | 'furlpay'
COMPLIANCE_IDENTITY_PROVIDER=persona
COMPLIANCE_SCREENING_PROVIDER=furlpay

# ComplyAdvantage AML/PEP/Sanctions screening API key & webhook secret
COMPLYADVANTAGE_API_KEY=
COMPLYADVANTAGE_WEBHOOK_SECRET=

# Circle Compliance Engine — address screening (POST /v1/w3s/compliance/screening/addresses).
# Runs after the local OFAC SDN check on transfers and checkout (lib/compliance/addressScreening.ts).
# Unset → OFAC only. Set but unreachable → FAIL CLOSED (screening_unavailable blocks).
# Circle does not screen Base; Base addresses get the OFAC check only.
CIRCLE_COMPLIANCE_API_KEY=
# Optional base URL override (default https://api.circle.com).
CIRCLE_COMPLIANCE_API_URL=

# Identity verification & biometric liveness (Persona). NEXT_PUBLIC_* is exposed
# to the browser to launch the embedded Inquiry; PERSONA_WEBHOOK_SECRET verifies
# the persona-signature header on inbound webhooks (constant-time, rotation-aware).
PERSONA_API_KEY=
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=
NEXT_PUBLIC_PERSONA_ENV=sandbox
PERSONA_WEBHOOK_SECRET=

# Stripe Crypto / stablecoin checkout (Furlpay Connect, powered by Bridge).
# Enable "Crypto" under Dashboard → Payments → Payment methods. STRIPE_SECRET_KEY
# is server-side; NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY renders Elements;
# STRIPE_WEBHOOK_SECRET verifies the stripe-signature header.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple Pay top-up (POST /api/topup/apple-pay, called by the iOS Guardian app).
# The merchant identifier from the Apple Developer portal, e.g.
# "merchant.com.furlpay.app". The PKPaymentToken the device returns is opaque
# ciphertext that only the processor's merchant private key can open, so this
# pairs with STRIPE_SECRET_KEY above — with INTEGRATION_MODE=live and either
# value missing, the route fails closed rather than crediting a balance
# against a capture that never happened.
APPLE_PAY_MERCHANT_ID=

# Card authorization (JIT funding) webhook — HMAC secret for the
# furlpay-signature header on POST /api/webhooks/card-auth. In production the
# route 503s until this is set (the sandbox fallback is repo-public).
FURLPAY_CARDAUTH_ENDPOINT_SECRET=

# 3DS2 step-up threshold in USD: transactions at/above this amount trigger an
# out-of-band biometric approval in the app instead of frictionless approval.
FURLPAY_3DS_CHALLENGE_USD=50

# EIP-7702 + Circle Paymaster — "pay gas in USDC from a plain EOA".
#
# Post-Pectra an EOA can delegate to a smart-account implementation for the
# duration of a transaction, making it ERC-4337 capable with no per-user
# contract deployment. Circle Paymaster then takes the gas fee in USDC.
#
# This is NOT a replacement for /api/transfers/gasless, which stays sponsored
# (FurlPay's relayer absorbs the gas). It inverts the payer, so the cost does
# not grow with volume.
#
# With these unset, /api/transfers/sponsored reports the scheme unavailable and
# points clients at the sponsored EIP-3009 rail. A delegate implementation must
# ALSO be allowlisted in lib/eip7702.ts (ALLOWED_DELEGATES) — it ships empty,
# because an unverified delegate address is exactly what drains accounts.
CIRCLE_PAYMASTER_ADDRESS_ARBITRUM=
CIRCLE_PAYMASTER_ADDRESS_BASE=
CIRCLE_PAYMASTER_ADDRESS_ETHEREUM=
ERC4337_BUNDLER_URL_ARBITRUM=
ERC4337_BUNDLER_URL_BASE=
ERC4337_BUNDLER_URL_ETHEREUM=

# Live JIT balance checks read the user's USDC on Arbitrum One under a strict
# time budget (issuer webhooks must answer in <2s). Defaults to the public RPC;
# use a dedicated endpoint (Alchemy/QuickNode) in production.
ARBITRUM_RPC_URL=
# Optional secondary RPC: with both set, x402 settlement/verification fail over
# via viem fallback() when the primary errors or rate-limits. Use a DIFFERENT
# provider than the primary (e.g. QuickNode primary + dRPC fallback). The same
# _FALLBACK suffix works for every per-network RPC var.
ARBITRUM_RPC_URL_FALLBACK=

# Web Push (VAPID) for 3DS2 transaction-approval notifications.
# Generate once:  npx web-push generate-vapid-keys
FURLPAY_VAPID_PUBLIC_KEY=
FURLPAY_VAPID_PRIVATE_KEY=
FURLPAY_VAPID_SUBJECT=mailto:security@furlpay.com

# FCM HTTP v1 for the NATIVE Android app (web-push cannot reach it).
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key; paste the JSON here raw or base64-encoded.
FURLPAY_FCM_SERVICE_ACCOUNT=

# On-chain deposit detection (QuickNode Streams / Alchemy Notify webhooks on
# POST /api/webhooks/deposit-detect; x-qn-signature / x-alchemy-signature HMAC).
# Optional per-chain treasury watch addresses (TREASURY_ADDRESS_BSC, …) are
# checked alongside the user's Safe address.
DEPOSIT_WEBHOOK_SECRET=
QUICKNODE_WEBHOOK_SECRET=
TREASURY_ADDRESS_BSC=
# Optional source-IP allowlist for deposit webhooks (comma-separated; empty =
# disabled). Defense in depth on top of the HMAC — only enable with IPs
# confirmed from the provider's docs, or legitimate webhooks will 403.
DEPOSIT_WEBHOOK_ALLOWED_IPS=

# Transactional email (Resend). Domain must be verified (SPF/DKIM DNS records
# from the Resend dashboard) before live sends. EMAIL_FROM must use the
# verified domain. RESEND_WEBHOOK_SECRET (whsec_…) verifies the Svix-signed
# bounce/complaint feed on POST /api/webhooks/resend, which drives the
# suppression list. Unset API key = sends log to console (mock).
RESEND_API_KEY=
EMAIL_FROM=Furlpay <hello@furlpay.com>
RESEND_WEBHOOK_SECRET=
# Support chat-bubble messages are forwarded here (POST /api/support/message).
SUPPORT_INBOX=support@furlpay.com

# Zendesk JWT SSO (GET /api/support/sso). Dormant (404) until BOTH are set.
# Zendesk admin -> Account -> Security -> End users -> JWT.
ZENDESK_SUBDOMAIN=
ZENDESK_SHARED_SECRET=

# Coinbase CDP Onramp/Offramp (0% provider fees on USDC on/offramps). Create
# an API key at portal.cdp.coinbase.com — ID + secret (base64 Ed25519 for
# current keys; legacy PEM EC keys also work). Powers the hosted checkout URL
# on POST /api/onramp/session and POST /api/offramp/session (lib/services/
# coinbaseRamp.ts). Unset = demo onramp sessions only, offramp returns 503.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Internal names for the same CDP key; read first, CDP_* is the fallback.
FURLGATEWAY_API_KEY_ID=
FURLGATEWAY_API_KEY_SECRET=

# x402 XSGD settlement (StraitsX, MAS-regulated). Defaults to the verified
# on-chain deployment for the active X402_NETWORK (arbitrum/ethereum/polygon/
# solana); override the address or the mock USD/SGD rate here. Live builds
# should price XSGD from an FX oracle.
X402_XSGD_ADDRESS=
X402_XSGD_USD_RATE=0.78

# x402 LIVE on-chain settlement. When INTEGRATION_MODE=live (or
# X402_ENFORCE_SIGNATURE=1) the facilitator recovers the EIP-3009 signer and
# submits transferWithAuthorization on-chain via this fee-payer key, waiting for
# the confirmation depth the amount requires. Use a DEDICATED hot key that holds
# only gas (funded from cold storage); prefer a KMS/HSM signer in production.
# Unset in live mode = settle() fails closed ("settler_unavailable") — it never
# credits against a mock. Leave unset for the zero-credential mock/demo path.
# DEVELOPMENT AND STAGING ONLY. x402Settler refuses this key outright when
# FURLPAY_ENV=production: a private key in an environment variable is readable
# from a heap dump, a crash report and any accidental serialisation. Production
# signs through FURLPAY_KMS_PROVIDER and needs FACILITATOR_EVM_ADDRESS instead.
FACILITATOR_EVM_PRIVATE_KEY=
# The fee-payer's public address. Required whenever a KMS does the signing —
# the KMS returns a signature, not an account, so this is how the settler knows
# which address it is acting as.
FACILITATOR_EVM_ADDRESS=
# Force signature verification + real settlement regardless of INTEGRATION_MODE
# (e.g. to exercise the live path in a preview deployment). 1 = on.
X402_ENFORCE_SIGNATURE=
# Optional per-network RPC overrides for the settler (else viem public RPC).
BASE_SEPOLIA_RPC_URL=

# Durable KV (challenges, push subscriptions, webhook dedup, rate limits,
# booking locks). Upstash Redis REST credentials — the Vercel Marketplace sets
# KV_REST_API_URL/TOKEN, which are also honored. Unset = bounded in-memory
# fallback (single instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable database (Supabase Postgres) — replaces the in-memory user store.
# Schema + cutover plan: supabase/README.md. SERVICE_ROLE key is server-side
# ONLY (RLS is enabled with no policies; the anon key is unused). Unset =
# in-memory store (demo mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PRIVATE Supabase Storage bucket holding gated research PDFs (lib/research).
# Must NOT be a public bucket: delivery is a 60-second signed URL issued only
# after email verification. Unset = gated downloads answer 503, never a public link.
RESEARCH_PDF_BUCKET=

# Where replies to transactional email should land. Mail is SENT from
# send.furlpay.com (protects root-domain reputation) but that subdomain has no
# MX, so replies to the From address bounce. This must be an address on a
# domain that actually receives mail (root furlpay.com, via Namecheap Private
# Email). Defaults to SUPPORT_INBOX, then support@furlpay.com.
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Financial environment + money-feature flags
# ---------------------------------------------------------------------------
# Which environment this deployment is, for money purposes: development |
# staging | production. Deliberately SEPARATE from NODE_ENV, which Next sets to
# "production" for preview branches as well — inferring from it would treat a
# preview as a place where real money may move. Unset defaults to development
# unless this is a genuine production deployment.
FURLPAY_ENV=development

# Emergency stop. Any truthy value disables EVERY money capability at once and
# is checked before any per-flag setting, so nothing below can defeat it.
FURLPAY_MONEY_KILL_SWITCH=

# Freeze parts of the consumer API (503) without a deploy. Comma-separated, e.g.
# /api/travel,/api/investing. Unset freezes nothing. Only the prefixes listed in
# lib/featureGate.ts FREEZABLE_PREFIXES are honoured; anything else is ignored.
FURLPAY_FROZEN_API_PREFIXES=

# Per-capability switches. All default OFF. Each also requires its own
# credentials to be present before it can actually turn on — an enabled flag
# with missing credentials reports as off, with the missing names listed at
# GET /api/ops/readiness (admin). See apps/web/src/lib/flags.ts.
#
# BROKERAGE_LIVE            needs ALPACA_API_KEY_ID + ALPACA_API_SECRET_KEY.
#                           OFF means order submission returns 503, never a
#                           simulated fill.
# ONCHAIN_BALANCES_LIVE     read-only chain reads; permitted in development.
# ONCHAIN_SETTLEMENT_LIVE   needs FURLPAY_KMS_PROVIDER + ARBITRUM_RPC_URL.
# TOKENIZED_STOCKS_LIVE     needs FURLPAY_STOCK_TOKEN_REGISTRY_VERIFIED.
# AI_TRADING_LIVE           needs the Alpaca credentials.
# DEFI_COLLATERAL_LIVE      cannot be enabled: the collateral risk engine is
#                           not built (see flags.ts `unimplemented`).
# CROSS_CHAIN_STOCKS_LIVE   cannot be enabled: per-issuer transfer-restriction
#                           checks are not implemented.
# HARDWARE_WALLET_LIVE      signing only; no credentials required.
# BANKING_LIVE              cannot be enabled: no banking / payment-aggregator
#                           partner is contracted and no IndiaRailAdapter
#                           exists. FurlPay cannot reach UPI/IMPS/NEFT/RTGS
#                           directly — those run through a bank or an
#                           RBI-authorised aggregator holding customer funds in
#                           escrow at a scheduled commercial bank.
# ONRAMP_LIVE               cannot be enabled: the provider capability matrix
#                           (lib/providers/capability.ts) is empty, so provider
#                           selection would find nothing.
# OFFRAMP_LIVE              cannot be enabled: no off-ramp provider, and no
#                           verified-beneficiary path (penny drop / name match).
# CARD_ISSUING_LIVE         cannot be enabled: no card issuer is integrated.
#                           OFF means every card route returns 503 in
#                           production rather than minting a card object with
#                           a random last-4 and the label "Visa".
# CREDIT_LIVE               cannot be enabled: no lender, no draw/repay ledger,
#                           no liquidation engine. OFF means /api/credit
#                           returns 503 in production.
# BILL_PAY_LIVE             cannot be enabled: no biller network. OFF means
#                           /api/bills refuses to "pay" in production.
BROKERAGE_LIVE=
TOKENIZED_STOCKS_LIVE=
ONCHAIN_SETTLEMENT_LIVE=
# Settlement circuit breaker (lib/settlementSafety.ts,
# docs/SETTLEMENT-CIRCUIT-BREAKER-RUNBOOK.md). None are secrets.
# SETTLEMENT_SAFETY_AUTOHALT  "enforce" lets detectors persist halts on their
#                             own. Anything else = SHADOW: would-be halts are
#                             logged to history and nothing is halted. Manual
#                             halts and per-request refusals apply either way.
# SETTLEMENT_RECOVERY_MIN_APPROVERS  raises (never lowers) the approver floor:
#                             2 for critical incidents, 1 for high.
# SETTLEMENT_MAX_HEAD_AGE_S   newest-block age before a head counts as stale
#                             (default 120). Set high for an idle local hardhat.
# SETTLEMENT_MAX_PROVIDER_LAG_BLOCKS  cross-provider head gap (default 50).
# SETTLEMENT_MAX_PER_HOUR     settlements per network per hour before a halt.
#                             Unset = off; derive it from real traffic first.
SETTLEMENT_SAFETY_AUTOHALT=
SETTLEMENT_RECOVERY_MIN_APPROVERS=
# SETTLEMENT_RECOVERY_APPROVER_EMAILS  comma-separated (max 5) accounts that may
#                             ONLY read breaker state and approve recovery: the
#                             second distinct approver critical incidents need.
#                             Not admins. Unset = none (critical recovery stays
#                             fail-closed with a single admin).
SETTLEMENT_RECOVERY_APPROVER_EMAILS=
SETTLEMENT_MAX_HEAD_AGE_S=
SETTLEMENT_MAX_PROVIDER_LAG_BLOCKS=
SETTLEMENT_MAX_PER_HOUR=
ONCHAIN_BALANCES_LIVE=
DEFI_COLLATERAL_LIVE=
AI_TRADING_LIVE=
CROSS_CHAIN_STOCKS_LIVE=
HARDWARE_WALLET_LIVE=
CARD_ISSUING_LIVE=
BANKING_LIVE=
ONRAMP_LIVE=
OFFRAMP_LIVE=
CREDIT_LIVE=
BILL_PAY_LIVE=
# REWARDS_LIVE: cannot be enabled — no referral attribution or rewards ledger.
REWARDS_LIVE=
FURLPAY_REWARDS_LEDGER=
# RECURRING_INVESTING_LIVE: cannot be enabled — schedules are not durable and
# no worker executes them.
RECURRING_INVESTING_LIVE=
# P2P_LIVE: cannot be enabled — P2P state is process memory with no cross-instance lock.
P2P_LIVE=
FURLPAY_P2P_STORE=
# ACCOUNT_SPEND_LIVE: cannot be enabled — no rail delivers value debited by /api/account/spend.
ACCOUNT_SPEND_LIVE=

# Credit and bill-pay partners. Named for the day they exist; setting them
# today changes nothing, because both flags carry an `unimplemented` reason.
FURLPAY_CREDIT_PROVIDER=
FURLPAY_CREDIT_PROVIDER_API_KEY=
FURLPAY_BILLPAY_PROVIDER=
FURLPAY_BILLPAY_PROVIDER_API_KEY=

# The contracted fiat partners, and their credentials. Named for the day they
# exist. A capability row in lib/providers/capability.ts must ALSO reach
# contractStatus "live" with its evidence URL before any of these is selectable.
FURLPAY_BANKING_PARTNER=
FURLPAY_BANKING_PARTNER_API_KEY=
FURLPAY_ONRAMP_PROVIDER=
FURLPAY_ONRAMP_PROVIDER_API_KEY=
FURLPAY_OFFRAMP_PROVIDER=
FURLPAY_OFFRAMP_PROVIDER_API_KEY=

# Ramp partners go by internal names in code (lib/providers/rampEnv.ts):
# FurlGateway = Coinbase CDP, FurlBridge = Transak, FurlPayout = Echo Money.
# Users are always shown the real company. Each FURL* name is read first and
# the vendor name is the fallback, so existing deployments keep working.
#
# FurlBridge (Transak). No contract yet; capability rows are "in_discussion".
# Webhooks (POST /api/webhooks/furlbridge) are verified as Transak documents
# them: an HS256 JWT in the body "data" field, keyed with the Partner Access
# Token below. Unset token => every webhook is refused (401).
FURLBRIDGE_API_KEY=
FURLBRIDGE_SECRET_KEY=
FURLBRIDGE_ACCESS_TOKEN=
FURLBRIDGE_API_URL=
# Legacy fallbacks for the four above.
TRANSAK_API_KEY=
TRANSAK_SECRET_KEY=
TRANSAK_ACCESS_TOKEN=
TRANSAK_API_URL=

# FurlPayout (Echo Money). No contract; its API and webhook scheme are
# unverified, so the adapter is never registered. No default API URL.
FURLPAYOUT_API_KEY=
FURLPAYOUT_API_SECRET=
FURLPAYOUT_API_URL=
ECHO_API_KEY=
ECHO_API_SECRET=
ECHO_API_URL=

# AES-256-GCM key for stored bank account numbers (lib/ramp/beneficiary.ts):
# base64 of 32 random bytes, e.g. `openssl rand -base64 32`. Unset => no bank
# account is stored. Beneficiary collection also needs a verification partner,
# which does not exist yet, so /api/offramp/beneficiary returns 503 regardless.
FURLPAY_BENEFICIARY_ENCRYPTION_KEY=

# AES-256-GCM key sealing partner ramp webhook signing secrets
# (lib/ramp/partnerConfig.ts): base64 of 32 random bytes. Unset => PUT
# /api/developer/ramp returns 503 and no partner callbacks are sent.
FURLPAY_PARTNER_WEBHOOK_KEY=

# WalletConnect / Reown relay project id, from https://dashboard.reown.com
#
# NOT a secret: it is a public routing identifier that appears in the relay
# URL, and the same value ships inside the app as
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID (native-app). It is registered HERE
# because lib/clientFlags/registry.ts gates the `wallet_connect` client flag on
# it: without a relay to reach, revealing the screen would only ever produce a
# connection error, so the flag stays off until this is set.
FURLPAY_WALLETCONNECT_PROJECT_ID=

# Pre-signature transaction simulation vendor (Blockaid or equivalent), used by
# /api/security/scan. BOTH are required: a provider name with no key produces
# an authentication failure that reads to the client like a transaction
# problem. Unset, the route still returns its own calldata decode and reports
# deepScanConfigured:false rather than inventing a verdict.
FURLPAY_TX_SIMULATION_PROVIDER=
FURLPAY_TX_SIMULATION_API_KEY=

# The contracted card issuer, and its API credential. Named for the day one
# exists; setting them today changes nothing, because CARD_ISSUING_LIVE carries
# an `unimplemented` reason that outranks any environment value.
FURLPAY_CARD_ISSUER=
FURLPAY_CARD_ISSUER_API_KEY=

# Set ONLY after a person has opened an issuer's published token list, copied a
# contract/mint address into lib/onchain/stockTokenRegistry.ts, and marked the
# entry verified. The registry ships with NO addresses — never populate one
# from memory. GET /api/ops/readiness reports how many remain unverified.
FURLPAY_STOCK_TOKEN_REGISTRY_VERIFIED=

# Which backend signs on-chain transactions. Unset, or "env", keeps
# ONCHAIN_SETTLEMENT_LIVE unavailable — production custody must not sign from
# an environment variable.
#
#   turnkey   IMPLEMENTED. Enclave signing; needs the TURNKEY_* block above
#             plus the wallet address for the key being used.
#   aws-kms   not implemented — resolveKms() refuses it BY NAME rather than
#   gcp-kms   falling back to the env signer, because a silent fallback would
#   vault     defeat the entire boundary.
#   env       development only; refused when FURLPAY_ENV=production.
FURLPAY_KMS_PROVIDER=

# Google Places API (New) -- hotel detail enrichment (name, rating, review
# count, editorial summary, photos) for ONE hotel a user opens. NOT a hotel
# database: Places cannot enumerate (Nearby caps at 20 results with no
# pagination, Text Search at 60) and its terms permit storing the place ID
# only -- never ratings, photos or addresses. Server-side only; the photo
# proxy exists so this key never reaches a browser.
# Enable "Places API (New)" in Google Cloud and restrict the key to it.
# Absent => hotel detail returns 503; the map and OSM markers are unaffected.
GOOGLE_PLACES_API_KEY=

# Discord channel webhook the daily market brief posts to
# (GET /api/cron/market-brief, scheduled 21:30 UTC = 17:30 US/Eastern in EDT).
# Create it on the target channel: Edit Channel -> Integrations -> New Webhook
# -> Copy Webhook URL. This URL is a bearer credential -- anyone holding it can
# post into that channel forever -- so it is server-side only and never logged
# in full (lib/discordWebhook.ts redacts the token before any error or run
# record is written).
# Unset => the job returns 503 not_configured instead of building a brief
# nobody receives. Use ?dry=1 to build and inspect the payload without posting.
DISCORD_MARKET_WEBHOOK_URL=

# Watchlist for the daily market brief, comma-separated (e.g.
# "NVDA,AAPL,MSFT,^VIX,BRK-B"). Unset falls back to a default mega-cap list.
# Capped at 12 symbols because each one costs a request against a shared,
# IP-rate-limited upstream. Entries are validated against /^[A-Z0-9.^=-]{1,12}$/
# before being interpolated into a URL -- an env var is not a trusted input.
FURLPAY_BRIEF_TICKERS=

# Telegram chat the daily market brief posts to (GET /api/cron/market-brief).
# Falls back to TELEGRAM_CHANNEL_ID when unset, so the existing @furlpayofficial
# channel works with no extra config; set this to send the brief to a different
# chat. The bot (TELEGRAM_BOT_TOKEN) must be an ADMIN of the target channel with
# "Post Messages", or the API returns 403 "bot is not a member of the channel
# chat" -- which the job reports as a non-retryable failure rather than retrying
# forever. Discord and Telegram are attempted independently: either alone is a
# valid configuration, and the run fails only if every configured destination
# does.
TELEGRAM_MARKET_CHAT_ID=

# --- Discord price cards (BTC / ETH / SOL / Gold) -------------------------
# A BOT token, not a user token. Create at
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# The bot needs View Channel, Send Messages, Embed Links and Attach Files in
# each channel below. Never commit a real value.
DISCORD_BOT_TOKEN=
# The server the bot operates in. REQUIRED by the welcome sweep below; the
# price cards use it only for a configuration sanity check.
DISCORD_GUILD_ID=
# One channel per asset. These are channel IDs (17-20 digits), NOT channel
# names: right-click a channel in Discord with Developer Mode on -> Copy ID.
# A card whose channel is unset is skipped; the others still post.
BTC_PRICE_CHANNEL_ID=
ETH_PRICE_CHANNEL_ID=
SOL_PRICE_CHANNEL_ID=
GOLD_PRICE_CHANNEL_ID=
# The index cards, same rules as above.
SPX_PRICE_CHANNEL_ID=
NDX_PRICE_CHANNEL_ID=
DJI_PRICE_CHANNEL_ID=
# Post every card into ONE channel instead, as a vertical feed. A per-asset
# variable above always wins, so setting this does not move cards that already
# have their own home.
MARKET_CARDS_CHANNEL_ID=

# --- Discord new-member welcome (/api/cron/discord-welcome) ---------------
# Greets members who have joined since the last sweep.
#
# WHY A SWEEP AND NOT AN EVENT LISTENER: `guildMemberAdd` is a Discord GATEWAY
# event, delivered over a WebSocket a bot process holds open for its whole
# life. This app is Next.js on Vercel — a function per request, frozen the
# moment it responds — so there is no process to hold that socket. The sweep
# asks Discord who joined instead, and remembers who it has already greeted.
#
# DEVELOPER PORTAL: enable the SERVER MEMBERS INTENT
# (Applications -> your app -> Bot -> Privileged Gateway Intents). Without it
# the member-list endpoint answers 403 and the sweep falls back to reading the
# system channel's "X joined" messages, which works but has no nickname or
# per-server avatar. No other privileged intent is needed.
#
# The channel the welcome is posted in. Unset = the feature is off.
WELCOME_CHANNEL_ID=
# Linked in the message as "check out #welcome to get started". Optional.
WELCOME_START_HERE_CHANNEL_ID=
# Defaults to on when WELCOME_CHANNEL_ID is set.
WELCOME_CHANNEL_ENABLED=
# Onboarding DM. OFF by default and it should stay that way unless you have a
# reason: Discord asks apps not to open DM channels in bulk, and doing so is a
# recognised way to get an application flagged.
WELCOME_DM_ENABLED=false
# How old a join may be and still earn a welcome. Stops a sweep that has been
# down for a week from waking up and posting a pile of week-late greetings.
WELCOME_MAX_AGE_HOURS=48
# Whether the FIRST EVER sweep may greet the members it finds. Leave off. The
# first run has no record of who has been welcomed, so with this on it would
# greet the entire existing server at once. Off, it records everyone as seen
# and greets nobody, and normal operation starts from the next run.
WELCOME_BACKFILL_ON_FIRST_RUN=false
# Greet bots that join. Off by default; a bot does not read its welcome.
WELCOME_INCLUDE_BOTS=false
# Append "FurlPay will never ask for your seed phrase or private key" to the
# welcome. On by default.
WELCOME_SECURITY_NOTE=true

# --- Discord roles, verification and voice (/api/discord/roles-setup) ------
# Operator endpoint, authenticated with the cron secret. A bare GET reports what
# it would do; ?apply=1 creates missing roles, raises the bot's role above them,
# posts the role picker and the verification panel, and creates the voice rooms.
#
# ROLE HIERARCHY IS THE THING THAT BREAKS FIRST. A bot can only assign roles
# positioned BELOW its own highest role, and Administrator does NOT override
# that. On a fresh server every role sits at position 1 alongside the bot's own,
# so nothing is assignable until the bot is moved up. ?apply=1 does this.
#
# Channel that holds the self-serve role picker.
ROLE_PICKER_CHANNEL_ID=
# Channel that holds the captcha verification panel.
VERIFY_CHANNEL_ID=

# FURL payment pricing. FURL has no oracle/peg; set this to a real, defensible
# price (e.g. from a live DEX pool) to enable FURL checkout. Unset = FURL
# checkout disabled (fails closed, never assumes a rate).
FURL_USD_PRICE=
\n# Blockaid\nBLOCKAID_API_KEY=\n
# Minimum supported client version per platform, as JSON. Clients below the
# floor are refused on money-moving routes with 426 Upgrade Required.
# UNSET blocks nothing. This is the only way to retire a mobile build that
# carries a known client-side bug. See lib/clientVersion.ts.
#   {"ios":"1.4.2","android":"1.4.2","wearos":"1.2.0"}
FURLPAY_MIN_CLIENT_VERSIONS=

# ---------------------------------------------------------------------------
# Registered by the Sep 30 2026 environment audit (see src/lib/env.ts).
# These were read by production code but undocumented. Secrets are marked;
# never prefix any of them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# secret
CRON_SECRET=
# secret
FURLPAY_CRON_SECRET=
# secret
FURLPAY_WEBHOOK_SECRET=
TURNKEY_API_URL=
STRIPE_ISSUING_KEY=
FURLPAY_NFT_INDEXER=
# secret
FURLPAY_NFT_INDEXER_API_KEY=
# secret
FURLPAY_ALERT_SLACK_WEBHOOK=
# secret
FURLPAY_ALERT_WEBHOOK_URL=
SOLANA_DEVNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ARC_RPC_URL=
ARC_TESTNET_RPC_URL=
TEMPO_RPC_URL=
TEMPO_TESTNET_RPC_URL=
CCTP_IRIS_API_URL=
CCTP_TESTNET=
REDIS_URL=
ARC_RAIL_LIVE=
ARC_MAINNET_ACTIVATED=
ARC_CONFIRMATIONS=
ARC_RECEIPT_TIMEOUT_MS=
X402_REQUIRE_RESOURCE_BINDING=
X402_SETTLEMENT_GAS_LIMIT=
SWAP_QUOTE_TTL_MS=
RAIN_ENFORCE_SOURCE_IP=
FURLPAY_STAKING_ETH_VAULT_NAME=
FURLPAY_STAKING_ETH_VAULT_SYMBOL=
FURLPAY_STAKING_ETH_REBASING_NAME=
FURLPAY_STAKING_ETH_REBASING_SYMBOL=
ALPACA_DATA_BASE=
MARKET_BRIEF_CHANNEL_ID=
FURLPAY_DISCORD_ADMINS=
FURLPAY_VERIFY_DOMAIN=

# Device attestation for mobile money actions (lib/attestation, audit P1-9).
# off | report | enforce. enforce = a mobile money action without a valid
# Play Integrity / App Attest token over a fresh nonce is refused (403).
FURLPAY_ATTESTATION_MODE=off
# Play App Signing cert SHA-256 digest(s), comma-separated, as Play Integrity reports them.
FURLPAY_PLAY_CERT_DIGESTS=

# Server-driven mobile config (GET /api/app/config, audit P2-11). x.y.z versions.
FURLPAY_MIN_ANDROID_VERSION=
FURLPAY_MIN_IOS_VERSION=
FURLPAY_APP_FORCE_UPDATE=0
# Comma-separated: send,swap,earn,cards,travel,wallet_link
FURLPAY_APP_DISABLED_FEATURES=
FURLPAY_APP_MESSAGE=

# Local development only. "1" makes unauthenticated pages (e.g. /analytics)
# sign in to the seeded demo account automatically instead of showing /login
# (GET /api/auth/dev-session). Ignored by every production build (NODE_ENV).
FURLPAY_DEV_AUTO_LOGIN=

# Circle user-controlled (MPC) wallets — /api/wallets/circle. Both KEY and APP_ID
# are required; either unset → 503. The API key stays server-side; the signed-in
# user receives a 60-minute userToken + encryptionKey for the Circle client SDK.
CIRCLE_W3S_API_KEY=
CIRCLE_W3S_APP_ID=
# Optional base URL override (default https://api.circle.com).
CIRCLE_W3S_API_URL=

# --- Search engines -----------------------------------------------------------
# Verification tokens rendered as <meta> tags by app/layout.tsx (Search Console,
# Bing Webmaster Tools). Unset = no tag.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# IndexNow key: 8-128 chars of [A-Za-z0-9-] (https://www.indexnow.org/documentation).
# Served at https://furlpay.com/indexnow.txt; unset = that URL 404s and
# submitIndexNow() returns "not_configured". Generate one, e.g. a UUID.
INDEXNOW_KEY=

# ── Allium (blockchain data) — /onchain ─────────────────────────────────────
# Explorer API key (app.allium.so → API keys). Sent as X-API-KEY to
# api.allium.so; server-side only. The Explorer API runs SAVED queries, so
# save two in the Allium app and put their ids here. Required output columns:
#   stablecoin daily:    day, tx_count, transfer_count, volume_usd, sender_count, recipient_count
#   stablecoin by chain: chain, volume_usd_latest_day, volume_usd_prior_7d_avg [, tx_count_latest_day]
#   corridors:           from_country, to_country, volume_usd  (ISO-3166 alpha-2)
# Reference SQL: docs/ALLIUM_INTEGRATION.md. Saved in the FurlPay Allium org
# on 2026-10-07: daily = LQ50l60RW267fBrQ8DoJ, by chain = zvPU0Sw05NnOqA4mJjFT
# (verify the by-chain query returns exactly the columns above).
# Unset = those cards say "not connected"; nothing is substituted.
ALLIUM_API_KEY=
ALLIUM_STABLECOIN_DAILY_QUERY_ID=
ALLIUM_CORRIDOR_QUERY_ID=
ALLIUM_STABLECOIN_CHAIN_QUERY_ID=
# Tokenized assets, refreshed daily into today's snapshot (bootstrap = the CSV
# import). Saved query returning: product_name, token_symbol, chain,
# issuer_name, asset_class, asset_type, market_cap_usd (cast to varchar).
ALLIUM_RWA_QUERY_ID=
# Ingestion — Allium Beam webhook sink -> POST https://furlpay.com/api/webhooks/allium
# HMAC key for X-Signature-256 (Beam: sha256=hex(HMAC(key, nonce.timestamp.raw_body))).
# Store the SAME value as an Allium organization secret and name it in the
# webhook sink's hash_key. >= 32 chars; unset = every delivery is refused.
ALLIUM_BEAM_WEBHOOK_SECRET=
# "1" only if the Beam pipeline runs is_zerolag (pre-finality data). Default:
# Beam delivers confirmed data, stored as 'confirmed'.
ALLIUM_BEAM_ZEROLAG=
# Extra addresses to track besides verified linked wallets and
# TREASURY_ADDRESS_<CHAIN>: "chain:address" or "*:address", comma-separated.
ONCHAIN_WATCH_ADDRESSES=
# Optional allowlist of Allium chain ids for backfill/reconcile, e.g.
# "base,ethereum,arbitrum,polygon,optimism,solana". Unset = every chain Allium
# reports wallet_transactions for (GET /api/v1/supported-chains/realtime-apis).
ONCHAIN_SYNC_CHAINS=
# Direct-to-node ingestion (lib/onchain/nodeIndexer.ts): opt-in list of
# chains whose OWN node is scanned for transfers of tracked addresses, using
# the existing <CHAIN>_RPC_URL (ETHEREUM_/BASE_/ARBITRUM_/POLYGON_/ROBINHOOD_)
# and SOLANA_RPC_URL for "solana" (solanaNodeIndexer.ts: wallets + their token
# accounts, SPL/Token-2022/SOL transfers, endpoint pinned by genesis hash).
# Point those at a self-hosted node for full sovereignty. The endpoint's
# eth_chainId must match the chain registry; finality = its 'finalized' tag.
# Poll: GET /api/cron/onchain-node[?chain=a,b] with x-furlpay-cron-key. For
# real time run scripts/onchain/node-tail.mjs next to the nodes: it scans each
# chain the moment its head moves.
ONCHAIN_NODE_CHAINS=
# Optional token allowlist "chain:0x…" / "*:0x…". Hosted public nodes refuse
# eth_getLogs without a contract address; a self-hosted node does not.
ONCHAIN_NODE_TOKENS=
# The same ONCHAIN_NODE_CHAINS list also drives the network-wide USDC index
# (lib/onchain/assetIndexer.ts, migration 0034): every USDC Transfer on the
# chain, finalized blocks only, committed exactly once with exact supply
# reconciliation. Its supply checks need eth_call at the committed (finalized,
# and after downtime older) blocks: free hosted endpoints often refuse state
# a few dozen blocks back ("archive"), so production should point
# <CHAIN>_RPC_URL at a full/archive node of its own.
# Optional INDEPENDENT provider per EVM chain used only to verify each range
# (last block hash + supply); a disagreement blocks the commit and is recorded.
# Chains whose last 1/5 minutes of USDC logs the /onchain live panel scans
# from the RPC (shared 30 s cache). Explicit opt-in: on a metered plan
# (Alchemy Free: 10-block eth_getLogs, 30M CU/month) this is the page's most
# expensive call; other chains show "Live window off" and get activity from
# the indexer instead. Example: ONCHAIN_LIVE_WINDOW_CHAINS=ethereum
ONCHAIN_LIVE_WINDOW_CHAINS=
ETHEREUM_RPC_URL_SECONDARY=
BASE_RPC_URL_SECONDARY=
ARBITRUM_RPC_URL_SECONDARY=
POLYGON_RPC_URL_SECONDARY=
