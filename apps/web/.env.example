# ---------------------------------------------------------------------------
# Stablecoin Super-App — environment variables
# All integrations run in MOCK mode by default so the app is fully runnable
# with zero credentials. Fill these in to swap a service to its live client.
# ---------------------------------------------------------------------------

# Master switch. "mock" (default) uses in-memory simulators. "live" requires keys.
INTEGRATION_MODE=mock

# Fingerprint / WebAuthn (FIDO2) — the Relying Party the passkey is bound to.
# RP_ID must be the site's registrable domain (no scheme/port); ORIGIN is the
# full origin the browser sees. Both accept a comma-separated list to support
# multiple domains (verification matches any; the FIRST value is the primary
# rpID used when generating options — set it to your registrable eTLD+1).
#   Prod example:  FURLPAY_RP_ID=furlpay.app   FURLPAY_ORIGIN=https://furlpay.app
# If unset, config is derived from Vercel's VERCEL_PROJECT_PRODUCTION_URL /
# VERCEL_URL, falling back to the localhost defaults below. The rpID is NEVER
# read from the request Host header (that would break phishing resistance).
FURLPAY_RP_ID=localhost
FURLPAY_ORIGIN=http://localhost:3000

# Android app's WebAuthn origin. REQUIRED for passkey sign-in from the native
# app: a native caller does not present https://furlpay.com — Play Services
# presents android:apk-key-hash:<base64url(SHA-256(signing cert))>. Give the
# signing certificate's SHA-256 (hex, colons optional) and the server derives
# that origin. Without it, every passkey assertion from the app is rejected on
# origin, no matter how correct the ceremony.
#
# The upload key's SHA-256 (apps/android/android.keystore):
#   15:92:F6:8B:BE:16:5A:EF:47:EB:51:30:39:A2:64:EF:41:95:6E:52:77:CB:8A:29:9B:9E:AD:E6:C1:13:29:13
# AFTER the first Play upload, Play re-signs the app — append the Play App
# Signing SHA-256 here too (comma-separated), exactly as you must in
# /.well-known/assetlinks.json. Get it from Play Console → App integrity.
FURLPAY_ANDROID_CERT_SHA256=

# Browser-extension WebAuthn origin. Since Chrome 122 an extension may assert a
# passkey for any rpID in its host_permissions; the browser reports the caller
# as chrome-extension://<id>, which this RP must trust explicitly (same
# mechanic as the Android apk-key-hash above). Set this ONLY to extension ids
# you publish — every value here is an origin allowed to approve payments, so a
# malicious extension update becomes a signing surface. Exact 32-char ids only
# (a-p); wildcards and malformed values are rejected. Comma-separated for a
# stable + beta channel. Leave EMPTY to reject all extension assertions.
FURLPAY_EXTENSION_ID=

# Session signing key (jose HS256). REQUIRED in production — the app refuses to
# start signing sessions with the weak dev fallback. Use >= 32 random chars.
FURLPAY_SESSION_SECRET=

# The ONLY account email allowed to hold the admin role (ops dashboard,
# compliance console, refunds). Defaults to the seeded founder account.
FURLPAY_ADMIN_EMAIL=ashutosh@furlpay.app

# Self-custodial wallet rollout stage (docs/SELF-CUSTODIAL-WALLET-DESIGN.md).
# 0 or unset = off (no behavior change). 1 = wallet linking (Phase 1) only.
# Higher stages (on-chain reads, deposits, real send) are NOT implemented yet.
FURLPAY_SELF_CUSTODY_STAGE=0

# Solana Actions / Blinks + Visa USDC settlement. MERCHANT_SOLANA_WALLET is the
# base58 treasury that receives settlements (Visa settles USDC on Solana to bank
# agents such as Cross River Bank / Lead Bank). Left blank, the Action endpoints
# build spec-correct demo transactions with no live RPC required.
MERCHANT_SOLANA_WALLET=
SOLANA_RPC_URL=
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Platform take rate on Solana checkouts, in basis points (50 = 0.5%, max
# 1000), split to PLATFORM_FEE_SOLANA_WALLET as a second transfer in the same
# transaction. Both must be set AND differ from MERCHANT_SOLANA_WALLET to
# activate — first-party checkouts (merchant == platform) need no split.
PLATFORM_FEE_BPS=
PLATFORM_FEE_SOLANA_WALLET=
# SOL/USD price used to size the SOL payment path (mock; use an oracle in prod).
SOLANA_SOL_USD_PRICE=150

# Compressed-NFT ticket receipts (Metaplex Bubblegum via Helius mint API).
# Unset = deterministic mock tickets with the identical response shape.
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Live flight/hotel search + booking (Duffel). duffel_test_ tokens return
# sandbox offers with the production schema; unset falls back to the demo
# inventory generator.
DUFFEL_API_KEY=

# Tripadvisor Terra -- travel discovery content (locations, ratings, official
# URLs). Auth is the X-API-Key HEADER; ?key= and Bearer both 401.
# CONTENT ONLY: no prices, no availability, no booking -- Duffel remains the
# only booking rail. Reviews and photos are NOT in this entitlement (404).
# Absent => discovery degrades gracefully; travel booking is unaffected.
TRIPADVISOR_API_KEY=

# Sign in with Google (Google Identity Services). Create an OAuth 2.0 Web client
# in Google Cloud Console; add your origin to "Authorized JavaScript origins".
# NEXT_PUBLIC_* is exposed to the browser to render the button; GOOGLE_CLIENT_ID
# is used server-side to verify the ID token. Leave blank to use the dev stub.
#
# GOOGLE_CLIENT_ID accepts a COMMA-SEPARATED list of accepted audiences. The
# native Android app is a SEPARATE OAuth client (create an "Android" client with
# package name com.furlpay.app and the signing cert's SHA-1:
#   77:65:71:D1:D1:89:26:9D:84:0D:02:2A:F0:78:85:F2:55:B5:A3:99
# ) and Google stamps its id_token with THAT client id as `aud`. List both here
# or every sign-in from the app is rejected as wrong-audience:
#   GOOGLE_CLIENT_ID=<web>.apps.googleusercontent.com,<android>.apps.googleusercontent.com
# The first entry stays the canonical one for the web button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Phone / email OTP (Twilio Verify). Create a Verify Service and paste its SID.
# Left blank (INTEGRATION_MODE=mock) codes are generated in-memory and logged to
# the server console so signup/login work with zero credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Auth & MPC key management (Turnkey / Dynamic.xyz)
DYNAMIC_ENVIRONMENT_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# On-chain smart accounts (Safe)
SAFE_TX_SERVICE_URL=
SAFE_RPC_URL=

# Fiat on/off-ramp (Bridge.xyz)
BRIDGE_API_KEY=

# FX & multi-currency banking (Wise)
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Cross-chain swap routing (Li.Fi). Live quotes work keyless at low rate
# limits; set the key for production traffic. LIFI_API_URL only needs changing
# for a self-hosted proxy (defaults to https://li.quest/v1).
LIFI_API_KEY=
LIFI_API_URL=
# Swap monetization (docs.li.fi/monetization-take-fees). LIFI_FEE is a FRACTION
# of from-token volume (0.002 = 0.2%, max 0.10) collected for LIFI_INTEGRATOR
# (defaults to "furlpay"; must match the API key's integrator string). Register
# fee-enabled at portal.li.fi BEFORE setting LIFI_FEE or quotes may fail.
LIFI_INTEGRATOR=
LIFI_FEE=

# Hard server-side per-transaction caps on the REAL execution rails (USD).
# Conservative launch defaults ($500 each) apply when unset; raise per rail as
# volume and monitoring mature. UI limits are advisory — these enforce.
FURLPAY_MAX_SWAP_USD=
FURLPAY_MAX_CCTP_USD=
FURLPAY_MAX_TRANSFER_USD=

# Fractional equities (Alpaca)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Card issuance (Marqeta / Lithic)
MARQETA_APP_TOKEN=
MARQETA_ADMIN_TOKEN=

# Compliance & risk scoring (Chainalysis / Persona)
CHAINALYSIS_API_KEY=

# KYC/AML alternative provider (Sumsub). SUMSUB_WEBHOOK_SECRET verifies the
# x-payload-digest header on POST /api/webhooks/sumsub (constant-time,
# HMAC_SHA1/256/512 per x-payload-digest-alg). App token pair drives the
# WebSDK access-token endpoint when Sumsub is the active KYC provider.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# Card issuing, stablecoin-native (Rain — Visa Principal Member). JIT
# authorizations arrive on the existing /api/webhooks/card-auth processor
# (FURLPAY_CARDAUTH_ENDPOINT_SECRET signs them); these credentials drive card
# provisioning API calls.
RAIN_API_KEY=
RAIN_WEBHOOK_SECRET=

# KYC/AML provider selection: identity = 'persona' | 'sumsub', screening = 'complyadvantage' | 'furlpay'
COMPLIANCE_IDENTITY_PROVIDER=persona
COMPLIANCE_SCREENING_PROVIDER=furlpay

# ComplyAdvantage AML/PEP/Sanctions screening API key & webhook secret
COMPLYADVANTAGE_API_KEY=
COMPLYADVANTAGE_WEBHOOK_SECRET=

# Identity verification & biometric liveness (Persona). NEXT_PUBLIC_* is exposed
# to the browser to launch the embedded Inquiry; PERSONA_WEBHOOK_SECRET verifies
# the persona-signature header on inbound webhooks (constant-time, rotation-aware).
PERSONA_API_KEY=
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=
NEXT_PUBLIC_PERSONA_ENV=sandbox
PERSONA_WEBHOOK_SECRET=

# Stripe Crypto / stablecoin checkout (Furlpay Connect, powered by Bridge).
# Enable "Crypto" under Dashboard → Payments → Payment methods. STRIPE_SECRET_KEY
# is server-side; NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY renders Elements;
# STRIPE_WEBHOOK_SECRET verifies the stripe-signature header.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple Pay top-up (POST /api/topup/apple-pay, called by the iOS Guardian app).
# The merchant identifier from the Apple Developer portal, e.g.
# "merchant.com.furlpay.app". The PKPaymentToken the device returns is opaque
# ciphertext that only the processor's merchant private key can open, so this
# pairs with STRIPE_SECRET_KEY above — with INTEGRATION_MODE=live and either
# value missing, the route fails closed rather than crediting a balance
# against a capture that never happened.
APPLE_PAY_MERCHANT_ID=

# Card authorization (JIT funding) webhook — HMAC secret for the
# furlpay-signature header on POST /api/webhooks/card-auth. In production the
# route 503s until this is set (the sandbox fallback is repo-public).
FURLPAY_CARDAUTH_ENDPOINT_SECRET=

# 3DS2 step-up threshold in USD: transactions at/above this amount trigger an
# out-of-band biometric approval in the app instead of frictionless approval.
FURLPAY_3DS_CHALLENGE_USD=50

# EIP-7702 + Circle Paymaster — "pay gas in USDC from a plain EOA".
#
# Post-Pectra an EOA can delegate to a smart-account implementation for the
# duration of a transaction, making it ERC-4337 capable with no per-user
# contract deployment. Circle Paymaster then takes the gas fee in USDC.
#
# This is NOT a replacement for /api/transfers/gasless, which stays sponsored
# (FurlPay's relayer absorbs the gas). It inverts the payer, so the cost does
# not grow with volume.
#
# With these unset, /api/transfers/sponsored reports the scheme unavailable and
# points clients at the sponsored EIP-3009 rail. A delegate implementation must
# ALSO be allowlisted in lib/eip7702.ts (ALLOWED_DELEGATES) — it ships empty,
# because an unverified delegate address is exactly what drains accounts.
CIRCLE_PAYMASTER_ADDRESS_ARBITRUM=
CIRCLE_PAYMASTER_ADDRESS_BASE=
CIRCLE_PAYMASTER_ADDRESS_ETHEREUM=
ERC4337_BUNDLER_URL_ARBITRUM=
ERC4337_BUNDLER_URL_BASE=
ERC4337_BUNDLER_URL_ETHEREUM=

# Live JIT balance checks read the user's USDC on Arbitrum One under a strict
# time budget (issuer webhooks must answer in <2s). Defaults to the public RPC;
# use a dedicated endpoint (Alchemy/QuickNode) in production.
ARBITRUM_RPC_URL=
# Optional secondary RPC: with both set, x402 settlement/verification fail over
# via viem fallback() when the primary errors or rate-limits. Use a DIFFERENT
# provider than the primary (e.g. QuickNode primary + dRPC fallback). The same
# _FALLBACK suffix works for every per-network RPC var.
ARBITRUM_RPC_URL_FALLBACK=

# Web Push (VAPID) for 3DS2 transaction-approval notifications.
# Generate once:  npx web-push generate-vapid-keys
FURLPAY_VAPID_PUBLIC_KEY=
FURLPAY_VAPID_PRIVATE_KEY=
FURLPAY_VAPID_SUBJECT=mailto:security@furlpay.com

# FCM HTTP v1 for the NATIVE Android app (web-push cannot reach it).
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key; paste the JSON here raw or base64-encoded.
FURLPAY_FCM_SERVICE_ACCOUNT=

# On-chain deposit detection (QuickNode Streams / Alchemy Notify webhooks on
# POST /api/webhooks/deposit-detect; x-qn-signature / x-alchemy-signature HMAC).
# Optional per-chain treasury watch addresses (TREASURY_ADDRESS_BSC, …) are
# checked alongside the user's Safe address.
DEPOSIT_WEBHOOK_SECRET=
QUICKNODE_WEBHOOK_SECRET=
TREASURY_ADDRESS_BSC=
# Optional source-IP allowlist for deposit webhooks (comma-separated; empty =
# disabled). Defense in depth on top of the HMAC — only enable with IPs
# confirmed from the provider's docs, or legitimate webhooks will 403.
DEPOSIT_WEBHOOK_ALLOWED_IPS=

# Transactional email (Resend). Domain must be verified (SPF/DKIM DNS records
# from the Resend dashboard) before live sends. EMAIL_FROM must use the
# verified domain. RESEND_WEBHOOK_SECRET (whsec_…) verifies the Svix-signed
# bounce/complaint feed on POST /api/webhooks/resend, which drives the
# suppression list. Unset API key = sends log to console (mock).
RESEND_API_KEY=
EMAIL_FROM=Furlpay <hello@furlpay.com>
RESEND_WEBHOOK_SECRET=
# Support chat-bubble messages are forwarded here (POST /api/support/message).
SUPPORT_INBOX=support@furlpay.com

# Zendesk JWT SSO (GET /api/support/sso). Dormant (404) until BOTH are set.
# Zendesk admin -> Account -> Security -> End users -> JWT.
ZENDESK_SUBDOMAIN=
ZENDESK_SHARED_SECRET=

# Coinbase CDP Onramp/Offramp (0% provider fees on USDC on/offramps). Create
# an API key at portal.cdp.coinbase.com — ID + secret (base64 Ed25519 for
# current keys; legacy PEM EC keys also work). Powers the hosted checkout URL
# on POST /api/onramp/session and POST /api/offramp/session (lib/services/
# coinbaseRamp.ts). Unset = demo onramp sessions only, offramp returns 503.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# x402 XSGD settlement (StraitsX, MAS-regulated). Defaults to the verified
# on-chain deployment for the active X402_NETWORK (arbitrum/ethereum/polygon/
# solana); override the address or the mock USD/SGD rate here. Live builds
# should price XSGD from an FX oracle.
X402_XSGD_ADDRESS=
X402_XSGD_USD_RATE=0.78

# x402 LIVE on-chain settlement. When INTEGRATION_MODE=live (or
# X402_ENFORCE_SIGNATURE=1) the facilitator recovers the EIP-3009 signer and
# submits transferWithAuthorization on-chain via this fee-payer key, waiting for
# the confirmation depth the amount requires. Use a DEDICATED hot key that holds
# only gas (funded from cold storage); prefer a KMS/HSM signer in production.
# Unset in live mode = settle() fails closed ("settler_unavailable") — it never
# credits against a mock. Leave unset for the zero-credential mock/demo path.
FACILITATOR_EVM_PRIVATE_KEY=
# Force signature verification + real settlement regardless of INTEGRATION_MODE
# (e.g. to exercise the live path in a preview deployment). 1 = on.
X402_ENFORCE_SIGNATURE=
# Optional per-network RPC overrides for the settler (else viem public RPC).
BASE_SEPOLIA_RPC_URL=

# Durable KV (challenges, push subscriptions, webhook dedup, rate limits,
# booking locks). Upstash Redis REST credentials — the Vercel Marketplace sets
# KV_REST_API_URL/TOKEN, which are also honored. Unset = bounded in-memory
# fallback (single instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable database (Supabase Postgres) — replaces the in-memory user store.
# Schema + cutover plan: supabase/README.md. SERVICE_ROLE key is server-side
# ONLY (RLS is enabled with no policies; the anon key is unused). Unset =
# in-memory store (demo mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where replies to transactional email should land. Mail is SENT from
# send.furlpay.com (protects root-domain reputation) but that subdomain has no
# MX, so replies to the From address bounce. This must be an address on a
# domain that actually receives mail (root furlpay.com, via Namecheap Private
# Email). Defaults to SUPPORT_INBOX, then support@furlpay.com.
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Financial environment + money-feature flags
# ---------------------------------------------------------------------------
# Which environment this deployment is, for money purposes: development |
# staging | production. Deliberately SEPARATE from NODE_ENV, which Next sets to
# "production" for preview branches as well — inferring from it would treat a
# preview as a place where real money may move. Unset defaults to development
# unless this is a genuine production deployment.
FURLPAY_ENV=development

# Emergency stop. Any truthy value disables EVERY money capability at once and
# is checked before any per-flag setting, so nothing below can defeat it.
FURLPAY_MONEY_KILL_SWITCH=

# Per-capability switches. All default OFF. Each also requires its own
# credentials to be present before it can actually turn on — an enabled flag
# with missing credentials reports as off, with the missing names listed at
# GET /api/ops/readiness (admin). See apps/web/src/lib/flags.ts.
#
# BROKERAGE_LIVE            needs ALPACA_API_KEY_ID + ALPACA_API_SECRET_KEY.
#                           OFF means order submission returns 503, never a
#                           simulated fill.
# ONCHAIN_BALANCES_LIVE     read-only chain reads; permitted in development.
# ONCHAIN_SETTLEMENT_LIVE   needs FURLPAY_KMS_PROVIDER + ARBITRUM_RPC_URL.
# TOKENIZED_STOCKS_LIVE     needs FURLPAY_STOCK_TOKEN_REGISTRY_VERIFIED.
# AI_TRADING_LIVE           needs the Alpaca credentials.
# DEFI_COLLATERAL_LIVE      cannot be enabled: the collateral risk engine is
#                           not built (see flags.ts `unimplemented`).
# CROSS_CHAIN_STOCKS_LIVE   cannot be enabled: per-issuer transfer-restriction
#                           checks are not implemented.
# HARDWARE_WALLET_LIVE      signing only; no credentials required.
BROKERAGE_LIVE=
TOKENIZED_STOCKS_LIVE=
ONCHAIN_SETTLEMENT_LIVE=
ONCHAIN_BALANCES_LIVE=
DEFI_COLLATERAL_LIVE=
AI_TRADING_LIVE=
CROSS_CHAIN_STOCKS_LIVE=
HARDWARE_WALLET_LIVE=

# Set ONLY after a person has opened an issuer's published token list, copied a
# contract/mint address into lib/onchain/stockTokenRegistry.ts, and marked the
# entry verified. The registry ships with NO addresses — never populate one
# from memory. GET /api/ops/readiness reports how many remain unverified.
FURLPAY_STOCK_TOKEN_REGISTRY_VERIFIED=

# Which backend signs on-chain transactions. Unset, or "env", keeps
# ONCHAIN_SETTLEMENT_LIVE unavailable — production custody must not sign from
# an environment variable.
FURLPAY_KMS_PROVIDER=

# Google Places API (New) -- hotel detail enrichment (name, rating, review
# count, editorial summary, photos) for ONE hotel a user opens. NOT a hotel
# database: Places cannot enumerate (Nearby caps at 20 results with no
# pagination, Text Search at 60) and its terms permit storing the place ID
# only -- never ratings, photos or addresses. Server-side only; the photo
# proxy exists so this key never reaches a browser.
# Enable "Places API (New)" in Google Cloud and restrict the key to it.
# Absent => hotel detail returns 503; the map and OSM markers are unaffected.
GOOGLE_PLACES_API_KEY=

# Discord channel webhook the daily market brief posts to
# (GET /api/cron/market-brief, scheduled 21:30 UTC = 17:30 US/Eastern in EDT).
# Create it on the target channel: Edit Channel -> Integrations -> New Webhook
# -> Copy Webhook URL. This URL is a bearer credential -- anyone holding it can
# post into that channel forever -- so it is server-side only and never logged
# in full (lib/discordWebhook.ts redacts the token before any error or run
# record is written).
# Unset => the job returns 503 not_configured instead of building a brief
# nobody receives. Use ?dry=1 to build and inspect the payload without posting.
DISCORD_MARKET_WEBHOOK_URL=

# Watchlist for the daily market brief, comma-separated (e.g.
# "NVDA,AAPL,MSFT,^VIX,BRK-B"). Unset falls back to a default mega-cap list.
# Capped at 12 symbols because each one costs a request against a shared,
# IP-rate-limited upstream. Entries are validated against /^[A-Z0-9.^=-]{1,12}$/
# before being interpolated into a URL -- an env var is not a trusted input.
FURLPAY_BRIEF_TICKERS=

# Telegram chat the daily market brief posts to (GET /api/cron/market-brief).
# Falls back to TELEGRAM_CHANNEL_ID when unset, so the existing @furlpayofficial
# channel works with no extra config; set this to send the brief to a different
# chat. The bot (TELEGRAM_BOT_TOKEN) must be an ADMIN of the target channel with
# "Post Messages", or the API returns 403 "bot is not a member of the channel
# chat" -- which the job reports as a non-retryable failure rather than retrying
# forever. Discord and Telegram are attempted independently: either alone is a
# valid configuration, and the run fails only if every configured destination
# does.
TELEGRAM_MARKET_CHAT_ID=
