# Guardian release signing — copy to `keystore.properties` and fill in.
#
# keystore.properties is gitignored, as are *.jks and *.keystore. Do not commit
# either: the .jks IS the upload identity, and Play cannot rotate an upload key
# without going through support.
#
# CI should skip this file entirely and set the environment variables instead
# (same names, GUARDIAN_ prefixed) so no secret is ever written to disk:
#
#   GUARDIAN_KEYSTORE_FILE, GUARDIAN_KEYSTORE_PASSWORD,
#   GUARDIAN_KEY_ALIAS, GUARDIAN_KEY_PASSWORD
#
# With NEITHER source configured the release build still succeeds but produces
# an UNSIGNED apk (`*-release-unsigned.apk`). That is deliberate — falling back
# to the debug key would produce an artifact that installs fine locally and is
# rejected only after upload.
#
# Generate an upload key:
#   keytool -genkeypair -v -keystore guardian-upload.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias guardian-upload
#
# Both app/mobile and app/wear read THIS one file. Play requires a Wear/phone
# pair to share a signing certificate, and the Data Layer will not pair across
# differing ones.

# Path is resolved relative to the guardian/ project root.
storeFile=guardian-upload.jks
storePassword=
keyAlias=guardian-upload
keyPassword=
