<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- allowBackup / dataExtractionRules

         Both DEFAULT TO ON. Leaving them unset put a finance app's local state
         — the Keystore-sealed session token's ciphertext, and the Room snapshot
         cache holding balances, spending and trips — into Android Auto Backup
         and into device-to-device transfer.

         The sealed token is useless off-device (its AndroidKeyStore key is
         non-exportable and does not travel), so restoring it elsewhere yields
         an undecryptable blob and a forced re-login — which the store already
         handles. The SNAPSHOT CACHE is the real exposure: it is plaintext
         financial history, and it would ride a backup to any restored device.

         The React Native app has shipped allowBackup="false" since it was
         written; this brings the Kotlin apps in line. -->
    <application
        android:name=".GuardianWearApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="FurlPay"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Standalone: usable without the phone once the token has synced. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- singleTop: a tile tap while the app is open must land in
             onNewIntent (route extra), not stack a second instance. -->
        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Data Layer inbox: auth token, snapshots, and alarm signals.

             exported="true" is REQUIRED — Play Services delivers these
             broadcasts from its own process, and an unexported service simply
             never receives them. It is not, however, a reason to leave the
             service open to every app on the watch.

             android:permission restricts binding to callers holding
             BIND_LISTENER, which is a Play Services signature permission: only
             GMS can start this service. Every tile and complication service
             below already carries its equivalent guard
             (BIND_TILE_PROVIDER / BIND_COMPLICATION_PROVIDER); this one was the
             single exported component in the file without one, and it is the
             one that handles the session token. -->
        <service
            android:name=".service.WearListenerService"
            android:exported="true"
            android:permission="com.google.android.gms.permission.BIND_LISTENER">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/guardian"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Alarm ladder (wrist half) — shortService: a 3-minute buzz has
             done its job; the phone keeps escalating regardless. -->
        <service
            android:name=".service.WatchAlarmService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Tiles -->
        <service
            android:name=".tile.WalletTileService"
            android:exported="true"
            android:label="@string/tile_wallet_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".tile.NextEventTileService"
            android:exported="true"
            android:label="@string/tile_next_event_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".tile.PortfolioTileService"
            android:exported="true"
            android:label="@string/tile_portfolio_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".tile.MarketTileService"
            android:exported="true"
            android:label="@string/tile_market_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".tile.TravelTileService"
            android:exported="true"
            android:label="@string/tile_travel_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".tile.QuickPayTileService"
            android:exported="true"
            android:label="@string/tile_quickpay_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Watch-face complications -->
        <service
            android:name=".complication.BalanceComplicationService"
            android:exported="true"
            android:label="@string/complication_balance_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>

        <service
            android:name=".complication.DailySpendComplicationService"
            android:exported="true"
            android:label="@string/complication_daily_spend_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>

        <service
            android:name=".complication.PortfolioChangeComplicationService"
            android:exported="true"
            android:label="@string/complication_portfolio_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>

        <service
            android:name=".complication.NextEventComplicationService"
            android:exported="true"
            android:label="@string/complication_next_event_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>
    </application>
</manifest>
