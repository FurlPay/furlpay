<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live voice screen only — session is screen-bound, never background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Life Guardian IS an alarm app: exact, Doze-proof reminders. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Tap to Pay (merchant contactless acceptance).

         The PERMISSION is unconditional, but the FEATURE is required="false"
         on purpose: Guardian is a finance app that happens to be able to take a
         payment, not a payment terminal. Marking NFC required would delist it
         on Google Play for every phone without an NFC radio, to gate one
         optional screen. The feature is checked at runtime instead — see
         TapToPayEnvironment. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- UPI QR scanning. Same reasoning as NFC above: the permission is
         declared, but the camera is NOT required=true — a phone without one
         should still install and use every other Guardian surface. The scan
         screen asks at runtime and degrades to an explanation if refused. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- UPI package visibility.

         Android 11 (API 30) hid other installed apps by default. WITHOUT this,
         resolving a `upi://pay?…` intent finds nothing even when GPay, PhonePe
         and Paytm are all installed — so a scanned merchant QR would report "no
         UPI app found" and tell the user to install one they already have.
         Nothing throws and nothing logs; the feature is simply dead.

         Only the scheme is declared, not individual <package> entries: NPCI
         requires every PSP app to register `upi://`, so naming apps would be a
         list that goes stale as PSPs come and go, and it buys nothing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".GuardianApp"
        android:label="FurlPay Guardian"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Watch → phone voice relay (Data Layer messages). -->
        <service
            android:name=".service.VoiceRelayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/guardian"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- FCM — dormant until google-services.json ships. -->
        <service
            android:name=".service.GuardianMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Alarm ladder runtime -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <activity
            android:name=".alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
    </application>
</manifest>
