node_modules
.next
.turbo
.vercel
out
dist
target
*.log
.git
.DS_Store

# APK decompilation audits (huge, never deploy)
*-apk/
indmoney-apk/
redotpay-apk/
robinhood-apk/
apktool-output/
*.apkm
*.apk
*.aab
*.zip

# Android app project (build artifacts + signing keystore — never deploy)
apps/android

# Native RN app — ships to Play, not Vercel (prebuild android/ tree is huge)
/native-app

# Local scratch experiments (not part of the app; breaks typecheck on Vercel)
apps/web/scratch

# Marketing workspace + raw demo videos at repo root only (anchored — the app
# has its own src/components/marketing that must deploy)
/marketing
/*.mp4

# Contracts workspace (compiled/deployed via Hardhat, not Vercel)
packages/contracts

# Guardian Wear OS / phone app (Kotlin/Gradle — huge build outputs, ships to
# Play + its own public repo, never Vercel)
/guardian

# Third-party site captures (reference only). `vercel deploy` uploads the
# working directory, so without this a competitor's site would be published
# from furlpay.com.
/reference

# Never upload local env files. The CLI already honours .gitignore, but this
# is the belt to that braces: an env file reaching the build would put
# credentials into a deployment artifact, and Vercel's own project env vars are
# the only place production secrets should come from.
.env
.env.*
!.env.example
