{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "gradleCommand": ":app:assembleDebug" }
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": false,
      "credentialsSource": "local",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "//": "The CANONICAL Play artifact is this React Native app. The TWA in apps/android shares the package name com.furlpay.app and must never be submitted — see apps/android/DEPRECATED.md.",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
