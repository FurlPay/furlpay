{
  "expo": {
    "name": "FurlPay",
    "slug": "furlpay",
    "version": "2.2.0",
    "scheme": "furlpay",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.furlpay.app",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "furlpay.com",
              "pathPrefix": "/l/"
            },
            {
              "scheme": "https",
              "host": "www.furlpay.com",
              "pathPrefix": "/l/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.reactnativepasskey.** { *; }\n-keep class expo.modules.** { *; }\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; }\n-keep,includedescriptorclasses class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FurlPay to use biometric authentication."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FurlPay uses the camera to scan payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E7FF52",
          "defaultChannel": "approvals"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
