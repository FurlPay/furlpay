# Keep secrets and local state out of the build context. `COPY . .` would
# otherwise bake these into the image layer.
.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

.git/
.gitignore
Dockerfile
.dockerignore
README.md
LICENSE

*.log
.DS_Store
