{
  "name": "@furlpay/furl-token",
  "version": "0.1.0",
  "private": true,
  "description": "FURL — the FurlPay ecosystem's USD-denominated payment currency (intended to operate as its stablecoin) on Solana. Token-2022 mint config, devnet-first launch scripts, and deterministic supply/allocation logic. Builds the on-chain token; the peg/reserves/redemption of a production stablecoin are separate infrastructure.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "plan:mint": "tsx scripts/create-furl-mint.ts",
    "plan:supply": "tsx scripts/mint-and-lock.ts",
    "devnet:mint": "tsx scripts/create-furl-mint.ts --cluster devnet --execute",
    "devnet:supply": "tsx scripts/mint-and-lock.ts --cluster devnet --execute",
    "audit:mainnet": "tsx scripts/audit-mainnet.ts",
    "plan:multisigs": "tsx scripts/create-multisigs.ts",
    "plan:migrate": "tsx scripts/migrate-allocations.ts --cluster mainnet-beta",
    "plan:revoke": "tsx scripts/revoke-mint-authority.ts --cluster mainnet-beta",
    "plan:liquidity": "tsx scripts/liquidity-plan.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.4",
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.1.8",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=20"
  }
}
