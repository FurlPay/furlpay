{
  "name": "@furlpay/rate-limit",
  "version": "0.1.0",
  "description": "Rate limiting for FurlPay API routes — sliding window, fixed window, token bucket algorithms with in-memory and Redis (Upstash) stores. Next.js middleware compatible.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/src/stores/redis.d.ts",
      "import": "./dist/src/stores/redis.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/rate-limit.test.js"
  },
  "keywords": [
    "rate-limit",
    "middleware",
    "api",
    "sliding-window",
    "token-bucket",
    "nextjs",
    "furlpay"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
