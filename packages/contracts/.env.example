# Deployer wallet (fund with Arbitrum Sepolia ETH from a faucet for testnet).
# NEVER commit the real .env.
DEPLOYER_PRIVATE_KEY=

# RPC overrides (defaults are the public endpoints)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Contract verification on Arbiscan
ARBISCAN_API_KEY=

# Fee treasury — receives the 0.5% Furlpay fee (defaults to deployer if unset)
FEE_TREASURY=

# Endorsed x402 facilitator EOA — the only caller allowed to create settlement
# records on X402Facilitator (defaults to deployer)
X402_FACILITATOR=

# Oracle key allowed to confirm delivery/check-in on FurlPayEscrow (defaults to
# deployer; use a dedicated key in prod)
CHECKIN_ORACLE=

# BookingReceipt token metadata base URI
RECEIPT_BASE_URI=https://furlpay.com/api/travel/bookings/receipt/

# USDC to wire the router to. Defaults per network in scripts/deploy.ts:
#   Arbitrum One:     0xaf88d065e77c8cC2239327C5EDb3A432268e5831 (native)
#   Arbitrum Sepolia: 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
USDC_ADDRESS=

# --- Programmable compliance (scripts/deploy-compliance.ts) ------------------
# Owner of the compliance contracts (defaults to deployer; use a multisig in prod)
COMPLIANCE_OWNER=
# Key allowed to record source-of-funds attestations (defaults to deployer)
COMPLIANCE_ATTESTOR=
# Chainalysis Sanctions Oracle override. Defaults per chain:
#   Arbitrum One: 0x40C57923924B5c5c5455c48D93317139ADDaC8fb ; testnets: none
SANCTIONS_ORACLE=
# Source-of-funds threshold in USDC (payments above this need an attestation)
SOF_THRESHOLD_USDC=1000
# Per-tx ComplianceEscrow cap in USDC (bounds custodial exposure; start low)
ESCROW_CAP_USDC=100

# --- Fork validation (test/compliance.fork.test.ts) -------------------------
# Archive RPC (e.g. Alchemy) to fork Arbitrum One for real-USDC/oracle tests
ARBITRUM_FORK_RPC=
ARBITRUM_FORK_BLOCK=

# --- OFAC SDN seeding (scripts/seed-sanctions.ts) ---------------------------
# Override the SDN address list source, or cap how many to seed (gas control)
SDN_LIST_URL=
SEED_LIMIT=
