#include "Base.xcconfig"

// furlpay.com, NOT the planned AWS host api.furlpay.com — that name has never
// resolved (NXDOMAIN, 2026-10-05). Must agree with native-app/app.config.js
// PRODUCTION_API_BASE and the Guardian prod flavors; pinned by
// guardian/core/network ReleaseApiBaseTest.
FURLPAY_ENV = prod
FURLPAY_API_HOST = furlpay.com

// NO SUFFIX. This is the identifier the App Store record owns; changing it
// orphans every existing install and every keychain item they hold.
FURLPAY_BUNDLE_SUFFIX =
FURLPAY_DISPLAY_NAME = FurlPay Guardian

APS_ENVIRONMENT = production

SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
STRIP_SWIFT_SYMBOLS = YES
