<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Guardian</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- Single-target watch app (watchOS 7+). The legacy two-bundle layout used
         WKWatchKitApp plus a separate extension; that shape is retired. -->
    <key>WKApplication</key>
    <true/>
    <key>WKCompanionAppBundleIdentifier</key>
    <string>com.furlpay.guardian</string>

    <!-- Push-to-talk on the watch relays to the phone, but the recognition
         itself runs on-watch, so both strings are needed here too. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>The microphone lets you ask Guardian a question from your wrist.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Speech recognition turns what you say into a command for Guardian.</string>

    <key>WKBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
